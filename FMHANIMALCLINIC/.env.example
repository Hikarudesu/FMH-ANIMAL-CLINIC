# Local development defaults. Set these as Railway Variables for production.
DJANGO_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Railway supplies DATABASE_URL when the PostgreSQL service is linked.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fmhclinic

GROQ_API_KEY=replace-with-your-new-groq-key
EMAIL_HOST_USER=your-gmail-address
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail-address